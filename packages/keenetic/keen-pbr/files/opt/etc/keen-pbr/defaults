KEEN_PBR="/opt/usr/bin/keen-pbr"
CONFIG="/opt/etc/keen-pbr/config.json"
DNSMASQ_HELPER="/opt/usr/lib/keen-pbr/dnsmasq.sh"

# Persist daemon activity to a log file so history survives a router reboot.
# The init script exports this into the daemon environment and creates the
# parent directory. Clear the value to disable the file log entirely.
KEEN_PBR_LOG_FILE="/opt/var/log/keen-pbr.log"
