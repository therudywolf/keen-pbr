#!/bin/sh

. /opt/etc/forest-pbr/defaults

ENABLED=yes
PROCS=$(basename "$KEEN_PBR")
PIDFILE="/opt/var/run/forest-pbr.pid"
ARGS="--config $CONFIG --pid-file $PIDFILE service"
PREARGS=""
POSTCMD=""
DESC="forest-pbr"
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IPSET_PROBE_SET="kpbr_probe_hash_net"
IPSET_COMPONENTS_MESSAGE="ipset kernel modules are not available. Make sure that you followed the installation process and installed all required components: Netfilter Subsystem Kernel Modules and Xtables-addons Extension Package for Netfilter."
KEENETIC_RCI_STARTUP_ATTEMPTS=5

# Hand the optional persistent log file down to the daemon environment so its
# activity survives a reboot. Skipped silently when the value is unset.
if [ -n "$KEEN_PBR_LOG_FILE" ]; then
    export KEEN_PBR_LOG_FILE
fi

# Create the parent directory of the persistent log file. The daemon falls back
# to stdout/stderr if this fails, so a failure here is non-fatal.
ensure_log_dir() {
    [ -n "$KEEN_PBR_LOG_FILE" ] || return 0
    mkdir -p "$(dirname "$KEEN_PBR_LOG_FILE")" 2>/dev/null || true
}

log() {
    logger -s -t "forest-pbr" "$1"
}

log_error() {
    logger -s -t "forest-pbr" -p "user.err" "$1"
}

is_module_loaded() {
    local module="$1"

    lsmod | grep -q "^${module}[[:space:]]"
}

module_path_for() {
    local module="$1"

    printf '/lib/modules/%s/%s.ko\n' "$(uname -r)" "$module"
}

ensure_kernel_module_loaded() {
    local module="$1"
    local module_path="$2"
    local missing_message="$3"
    local failure_message="$4"

    if is_module_loaded "$module"; then
        return 0
    fi

    if [ ! -f "$module_path" ]; then
        log_error "$missing_message"
        return 0
    fi

    if ! insmod "$module_path" 2>/dev/null; then
        log_error "$failure_message"
        return 0
    fi

    return 0
}

try_kernel_module_loaded() {
    local module="$1"
    local module_path

    if is_module_loaded "$module"; then
        return 0
    fi

    module_path="$(module_path_for "$module")"
    if [ ! -f "$module_path" ]; then
        return 1
    fi

    insmod "$module_path" 2>/dev/null
}

ipset_hash_net_available() {
    command -v ipset >/dev/null 2>&1 || return 1

    if ipset create "$IPSET_PROBE_SET" hash:net family inet -exist >/dev/null 2>&1; then
        ipset destroy "$IPSET_PROBE_SET" >/dev/null 2>&1 || true
        return 0
    fi

    ipset destroy "$IPSET_PROBE_SET" >/dev/null 2>&1 || true
    return 1
}

# Print an RCI answer, bounded by curl -m. busybox wget -T segfaults on this
# firmware and plain wget has no timeout at all (it waits for as long as RCI
# keeps the connection open), so it is only the fallback without curl.
fetch_rci() {
    if command -v curl >/dev/null 2>&1; then
        curl -fs -m 5 "http://127.0.0.1:79/rci/$1"
    else
        wget -O - "localhost:79/rci/$1"
    fi
}

check_netfilter_addons_component() {
    local components

    if ! components="$(fetch_rci show/version/ndw/components 2>/dev/null)"; then
        log_error "Failed to fetch installed Keenetic components"
        return 0
    fi

    case ",$components," in
        *,opkg-kmod-netfilter-addons,*)
            return 0
            ;;
        *)
            log_error "Missing Keenetic component opkg-kmod-netfilter-addons"
            return 0
            ;;
    esac
}

# The daemon validates a keenetic DNS server against /rci/show/version, so give
# RCI a few seconds to come up. Every attempt is bounded by curl -m; without
# curl there is no safe way to bound it (see fetch_rci), so the wait is skipped.
wait_for_keenetic_rci() {
    local attempt=1

    if ! command -v curl >/dev/null 2>&1; then
        log "curl is not installed; not waiting for Keenetic RCI"
        return 0
    fi

    while [ "$attempt" -le "$KEENETIC_RCI_STARTUP_ATTEMPTS" ]; do
        if curl -s -m 2 -o /dev/null http://127.0.0.1:79/rci/show/version; then
            if [ "$attempt" -gt 1 ]; then
                log "Keenetic RCI became available after $attempt attempts"
            fi
            return 0
        fi

        if [ "$attempt" -lt "$KEENETIC_RCI_STARTUP_ATTEMPTS" ]; then
            log "Keenetic RCI is unavailable (attempt $attempt/$KEENETIC_RCI_STARTUP_ATTEMPTS); retrying in 1 second"
            sleep 1
        fi
        attempt=$((attempt + 1))
    done

    log_error "Keenetic RCI is still unavailable after $KEENETIC_RCI_STARTUP_ATTEMPTS attempts; continuing startup"
    return 0
}

ensure_ipset_modules_loaded() {
    if ipset_hash_net_available; then
        try_kernel_module_loaded xt_set >/dev/null 2>&1 || true
        return 0
    fi

    try_kernel_module_loaded nfnetlink >/dev/null 2>&1 || true
    try_kernel_module_loaded ip_set >/dev/null 2>&1 || true
    try_kernel_module_loaded ip_set_hash_net >/dev/null 2>&1 || true
    try_kernel_module_loaded xt_set >/dev/null 2>&1 || true

    if ipset_hash_net_available; then
        return 0
    fi

    log_error "$IPSET_COMPONENTS_MESSAGE Required probe failed: ipset create $IPSET_PROBE_SET hash:net family inet -exist"
}

# Pre-warm the IPv6 stack and the IPv6 netfilter tables the daemon needs.
#
# On Keenetic 4.9 / Entware mipsel-3.4 the kernel ships IPv6 and its iptables
# bits as on-demand modules. NDM does not load them eagerly: ip6_tables /
# ip6table_mangle only appear once something (a v6-bearing interface, an
# ip6tables call) triggers them. If S80forest-pbr fires before that happens,
# the daemon's first ipv6 probe sees no AF_INET6 socket family and no v6
# mangle table, decides "IPv6 unsupported", and the v6 PBR scaffolding is
# never built.
#
# This is best-effort: missing modules are not fatal because some hardware
# genuinely lacks IPv6 (the daemon will then correctly stay IPv4-only).
ensure_ipv6_modules_loaded() {
    # Core protocol stack must come up before any of the netfilter tables can
    # be created on top of it.
    try_kernel_module_loaded ipv6 >/dev/null 2>&1 || true

    # Conntrack/defrag — needed if any KeenPbr v6 rule ever wants to read
    # connection state. Loading them is cheap and matches what NDM does once
    # WAN6 lights up.
    try_kernel_module_loaded nf_defrag_ipv6 >/dev/null 2>&1 || true
    try_kernel_module_loaded nf_conntrack_ipv6 >/dev/null 2>&1 || true

    # ip6_tables framework, then the specific tables we touch (only `mangle`
    # is used for PBR today, but the `filter` table is what `ip6tables` lazy-
    # initialises when called with no -t flag and its absence has been seen
    # to confuse some probe paths).
    try_kernel_module_loaded ip6_tables >/dev/null 2>&1 || true
    try_kernel_module_loaded ip6table_filter >/dev/null 2>&1 || true
    try_kernel_module_loaded ip6table_mangle >/dev/null 2>&1 || true
}

ensure_xt_multiport_loaded() {
    local module_path

    module_path="$(module_path_for xt_multiport)"

    ensure_kernel_module_loaded \
        xt_multiport \
        "$module_path" \
        "xt_multiport module not loaded and not found at $module_path. You can safely ignore this message if you are running a NDMS version lower than 3.x" \
        "Failed to load xt_multiport from $module_path"
}

check_runtime_dependencies() {
    check_netfilter_addons_component
    ensure_ipset_modules_loaded
    ensure_ipv6_modules_loaded
    ensure_xt_multiport_loaded
}

enable_hwnat() {
    log "Enabling HW NAT..."
    sysctl -w net.ipv4.netfilter.ip_conntrack_fastnat=1 2>/dev/null || true
    sysctl -w net.netfilter.nf_conntrack_fastnat=1 2>/dev/null || true
}

disable_hwnat() {
    log "Disabling HW NAT..."
    sysctl -w net.ipv4.netfilter.ip_conntrack_fastnat=0 2>/dev/null || true
    sysctl -w net.netfilter.nf_conntrack_fastnat=0 2>/dev/null || true
}

signal_service() {
    local signal="$1"
    local pid

    if [ ! -s "$PIDFILE" ]; then
        log_error "Cannot send $signal to forest-pbr: PID file $PIDFILE is missing or empty"
        return 1
    fi

    read -r pid < "$PIDFILE"
    if [ -z "$pid" ]; then
        log_error "Cannot send $signal to forest-pbr: PID file $PIDFILE does not contain a PID"
        return 1
    fi

    if ! kill "-$signal" "$pid"; then
        log_error "Failed to send $signal to forest-pbr PID $pid from $PIDFILE"
        return 1
    fi

    log "Sent $signal to forest-pbr PID $pid"

    return 0
}

prepare_start() {
    ensure_log_dir
    wait_for_keenetic_rci
    check_runtime_dependencies
    disable_hwnat
}

prepare_stop() {
    enable_hwnat
    if [ -x "$DNSMASQ_HELPER" ]; then
        "$DNSMASQ_HELPER" deactivate || true
    fi
}

reapply_dnsmasq_config() {
    if [ -x "$DNSMASQ_HELPER" ]; then
        "$DNSMASQ_HELPER" activate || return 1
    fi
}

download_lists() {
    "$KEEN_PBR" --config "$CONFIG" download || true
}

# Boot-time detach (local patch 2026-10-21).
#
# At boot NDM runs rc.unslung from its "Opkg task queue" thread while holding
# the OPTWARE lock, and kills the whole "Opkg shell" process group if the
# script does not finish within ~120s. reapply_dnsmasq_config calls
# `forest-pbr generate-resolver-config`, which queries RCI
# /rci/show/dns-proxy; answering that needs DNS locks NDM cannot take while
# the Opkg thread is waiting on us, so the start sequence stalls until the
# timeout fires and the already-running daemon gets killed with the group.
#
# When started by rc.unslung we therefore only probe RCI (to record whether
# the stall is present) and re-launch the start sequence in its own session
# via start-stop-daemon -b, letting rc.unslung return immediately. The
# detached sequence starts the daemon right away but holds the dnsmasq
# reapply until that rc.unslung has exited (and NDM has dropped the lock),
# for at most BOOT_PARENT_WAIT_SECONDS.
BOOT_LOG="/opt/var/log/forest-pbr-boot.log"
BOOT_PARENT_WAIT_SECONDS=180

boot_log() {
    printf '%s up=%s %s\n' "$(date '+%F %T')" "$(cut -d' ' -f1 /proc/uptime)" "$1" >> "$BOOT_LOG"
}

launched_from_opkg_initrc() {
    [ -z "$FOREST_PBR_DETACHED" ] || return 1
    # rc.unslung runs init scripts as child processes: find hands it full
    # paths, which its `S* | *.sh` sourcing branch never matches. So look at
    # the parent; $0 still covers a caller that sources this file instead.
    tr '\0' ' ' 2>/dev/null < "/proc/$PPID/cmdline" | grep -q 'rc\.unslung' && return 0
    case "$0" in
        *rc.unslung*) return 0 ;;
    esac
    return 1
}

probe_rci() {
    local endpoint="$1"
    local code

    code="$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:79/rci/$endpoint" 2>/dev/null)"
    boot_log "rci probe $endpoint: curl rc=$? http=$code"
}

detach_boot_start() {
    # The rc.unslung to wait for: our parent, or this very shell when
    # rc.unslung sourced the script (see launched_from_opkg_initrc).
    local boot_parent="$PPID"

    case "$0" in
        *rc.unslung*) boot_parent="$$" ;;
    esac

    mkdir -p "$(dirname "$BOOT_LOG")" 2>/dev/null || true
    [ -f "$BOOT_LOG" ] && tail -n 200 "$BOOT_LOG" > "$BOOT_LOG.tmp" && mv "$BOOT_LOG.tmp" "$BOOT_LOG"
    boot_log "=== $1 from rc.unslung (pid $boot_parent), detaching"
    probe_rci show/version
    probe_rci show/dns-proxy
    FOREST_PBR_DETACHED=1 FOREST_PBR_BOOT_PARENT="$boot_parent" \
        start-stop-daemon -S -b -n forest-pbr-boot \
        -x /opt/bin/sh -- /opt/etc/init.d/S80forest-pbr "$1"
    log "Start sequence detached from rc.unslung (see $BOOT_LOG)"
}

# True while PID $1 is still the rc.unslung process, not a recycled PID.
boot_parent_running() {
    tr '\0' ' ' 2>/dev/null < "/proc/$1/cmdline" | grep -q 'rc\.unslung'
}

wait_for_boot_parent_exit() {
    local pid="$FOREST_PBR_BOOT_PARENT"
    local waited=0

    [ -n "$pid" ] || return 0
    while boot_parent_running "$pid"; do
        if [ "$waited" -ge "$BOOT_PARENT_WAIT_SECONDS" ]; then
            boot_log "rc.unslung (pid $pid) still running after ${waited}s, not waiting any longer"
            log_error "rc.unslung is still running after ${waited}s; reapplying the dnsmasq config anyway"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    boot_log "rc.unslung (pid $pid) has exited (waited ${waited}s)"
}

# POSTCMD of the detached start. rc.func runs POSTCMD as a plain word-split
# command with its output sent to /dev/null, hence one function that reports
# through the boot log and syslog.
boot_reapply_dnsmasq_config() {
    local rc

    wait_for_boot_parent_exit
    probe_rci show/dns-proxy
    boot_log "reapply_dnsmasq_config begin"
    reapply_dnsmasq_config
    rc=$?
    boot_log "reapply_dnsmasq_config end rc=$rc"
    [ "$rc" -eq 0 ] || log_error "Reapplying the dnsmasq config after boot failed (rc=$rc, see $BOOT_LOG)"
    return "$rc"
}

FOREST_PBR_SKIP_RC_FUNC=no

case "$1" in
    reload)
        reapply_dnsmasq_config || exit 1
        signal_service HUP
        exit $?
        ;;
    reapply-firewall)
        signal_service SIGUSR1
        exit $?
        ;;
    reapply-dnsmasq-config)
        reapply_dnsmasq_config
        exit $?
        ;;
    start|restart|restartall)
        if launched_from_opkg_initrc; then
            detach_boot_start "$1"
            FOREST_PBR_SKIP_RC_FUNC=yes
        elif [ -n "$FOREST_PBR_DETACHED" ]; then
            boot_log "detached start: prepare_start"
            prepare_start
            boot_log "detached start: download_lists"
            download_lists
            boot_log "detached start: launching daemon"
            POSTCMD="boot_reapply_dnsmasq_config"
        else
            prepare_start
            download_lists
            POSTCMD="reapply_dnsmasq_config"
        fi
        ;;
    stop|kill)
        prepare_stop
        ;;
esac

[ "$FOREST_PBR_SKIP_RC_FUNC" = yes ] || . /opt/etc/init.d/rc.func
